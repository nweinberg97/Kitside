# Copy to .env.local and fill in. Leave the Supabase values empty to run
# Kitside in "preview mode", where everything is stored in your browser only.

# Supabase project URL and anon (public) key: Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Social sign-in providers you have switched on in Supabase → Authentication → Providers.
# Comma-separated. Options: google, apple, linkedin_oidc
# Buttons for providers not listed here are shown as "Not set up yet" instead of pretending to work.
VITE_AUTH_PROVIDERS=

# Show fictional example rows stored in the database (from supabase/seed.sql) on the live site.
# The "See the demo" button works either way: it uses sample data in the visitor's browser.
VITE_SHOW_DEMO=true
