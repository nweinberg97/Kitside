# Public build settings for the live site. Both values are safe to commit:
# the URL is public and a Supabase *publishable* key is designed to ship in
# browser code. Data is protected by row-level security (supabase/schema.sql).
# Never put a secret / service_role key here.
VITE_SUPABASE_URL=https://akojekqdkcncsrckbtdh.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_Lwai35DdW2iGwv7sGT8Nbg_6tq6gszM

# Add providers here once they're switched on in Supabase → Authentication → Providers,
# e.g. VITE_AUTH_PROVIDERS=google,linkedin_oidc
VITE_AUTH_PROVIDERS=

VITE_SHOW_DEMO=false
